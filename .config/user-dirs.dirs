# naos · XDG user folders (read by browsers, file pickers, screenshot tools)
# Folders you don't use point at $HOME so no empty Desktop/Templates/... folders appear in ~.
XDG_DESKTOP_DIR="$HOME"
XDG_TEMPLATES_DIR="$HOME"
XDG_PUBLICSHARE_DIR="$HOME"
XDG_DOCUMENTS_DIR="$HOME"
XDG_DOWNLOAD_DIR="/data/Downloads"
XDG_MUSIC_DIR="/data/cloud/gdrive/music"
XDG_PICTURES_DIR="/data/cloud/gdrive/photo"
XDG_VIDEOS_DIR="/data/video"
