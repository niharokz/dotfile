# naos · ~/.config/.gitignore
# Paths here are relative to ~/.config. The dotfiles repo also has status.showUntrackedFiles=no,
# so this file mainly stops "dot add .config/<dir>" from picking up state, caches and secrets.

### 🔐 secrets and keys: never commit
.secrets
.dotfile/
gnupg/
docker/
rclone/
tailscale/
Surfshark/

### 🌐 browsers and app state (written by the apps, not config)
BraveSoftware/
microsoft-edge/
Electron/
vivaldi/
Code/
code-oss/
obsidian/
dconf/
pulse/
systemd/
QtProject.conf

### 🗃 apps whose folders are mostly cache or session data
GIMP/
libreoffice/
vlc/
cmus/
htop/
vifm/
zathura/
amfora/
lagrange/
bcompare5/
eteks/
java/
go/

### 🎨 theming generated by GUI tools
gtk-2.0/
gtk-3.0/
gtk-4.0/

### 🧹 leftovers
*.bak-*
*.orig
*.swp
