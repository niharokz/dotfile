# Exit if not interactive shell
[[ $- != *i* ]] && return    

# Load secrets (if exists)
[[ -f "$XDG_CONFIG_HOME/.secrets" ]] && . "$XDG_CONFIG_HOME/.secrets"

### ────────────────────────────
### 🔧 Command Shortcuts
alias c='clear'
alias conf="$WORK/tools/conf.sh"
alias d='docker'
alias data='cd $DATA'
alias do='cd $DATA/docker'
alias dr='docker compose down && docker compose up -d'
alias g='git'
alias home='cd ~'
alias l='exa -lars date'
alias rmv='mv -t /tmp'
alias v='nvim'
alias vi='nvim'
alias w='cd $WORK'

### ────────────────────────────
### 🧠 Dotfiles & Dev
alias dot='/usr/bin/git --git-dir=$HOME/.config/.dotfile --work-tree=$HOME'
alias pyenv='source $WORK/pyenv/bin/activate'
alias vih='$WORK/narch/header.sh'
alias h='$WORK/narch/headerize.py'
alias nf='$WORK/narch/niharfetch.sh'

### ────────────────────────────
### 📦 Archive Extractor
ex() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"   ;;
      *.tar.gz)    tar xzf "$1"   ;;
      *.bz2)       bunzip2 "$1"   ;;
      *.rar)       unrar x "$1"   ;;
      *.gz)        gunzip "$1"    ;;
      *.tar)       tar xf "$1"    ;;
      *.tbz2)      tar xjf "$1"   ;;
      *.tgz)       tar xzf "$1"   ;;
      *.zip)       unzip "$1"     ;;
      *.Z)         uncompress "$1";;
      *.7z)        7z x "$1"      ;;
      *.deb)       ar x "$1"      ;;
      *.tar.xz)    tar xf "$1"    ;;
      *.tar.zst)   unzstd "$1"    ;;
      *)           echo "'$1' cannot be extracted via ex()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

### ────────────────────────────
### 🧠 New Additions
alias f='fzf'                                 # Fuzzy finder
alias ports='sudo lsof -i -P -n | grep LISTEN' # View all listening ports

