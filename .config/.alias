# Load secrets (if exists)
[[ -f "$XDG_CONFIG_HOME/.secrets" ]] && source "$XDG_CONFIG_HOME/.secrets"


### ────────────────────────────
### 🔧 Command Shortcuts

alias c='clear'
alias g='git'
alias v='nvim'
alias vi='nvim'
alias f='fzf'
alias l='exa -lars date'
alias home='cd ~'
alias ports='sudo lsof -i -P -n | grep LISTEN'
alias s='sudo'


### ────────────────────────────
### 🐳 Docker

alias d='docker'
alias dc='docker compose'
alias dprune='docker system prune -f'

dr() { dc down && dc up -d; }
dbr() { dc down && dc build --no-cache && dc up -d; }
dlogs() { dc logs -f; }
dps() { dc ps; }
drestart() { dc restart; }
dp() { docker exec -it postgres psql -U nhr26 -d nihardb }


### ────────────────────────────
### 📁 Navigation

alias b='cd $BACKUP'
alias ddata='cd $DATA'
alias data='cd $DATA'
alias narch='cd $WORK/narch'
alias nhr='cd $WORK/nih.ar'
alias video='cd $DATA/video'
alias w='cd $WORK'
alias work='cd $WORK'
alias n='cd $DATA/notes'
alias note='cd $DATA/notes'
alias dod='cd $DATAR/docker'


### ────────────────────────────
### 🧠 Dev / Dotfiles

alias dot='/usr/bin/git --git-dir=$HOME/.config/.dotfile --work-tree=$HOME'
alias pywork='source "$WORK/pyenv/bin/activate"'
alias h='$WORK/narch/headerize.py'
alias nf='$WORK/narch/niharfetch.sh'
alias o='docker exec -it nimos_ollama ollama'
alias ol='o list'
alias op='o pull'
alias or='o run'
alias z='nvim $(fzf -m --preview="batcat --color=always {}")'


### ────────────────────────────
### ⚡ Narch Short Aliases

alias rmv='safe_move'
alias ex='extract_archive'
alias t='create_backup'
alias tr='extract_tar'
alias nf='$WORK/narch/niharfetch.sh'


### ────────────────────────────
### 📦 System / Package Helpers

# Detect distribution
if [ -f /etc/os-release ]; then
  . /etc/os-release
  DISTRO="$ID"
else
  DISTRO="unknown"
fi

# Arch
if [ "$DISTRO" = "arch" ]; then
  alias yay='paru'
  alias nay='paru -Rns'
fi

# Debian
if [ "$DISTRO" = "debian" ]; then
  alias apt='sudo apt'
  alias nay='sudo apt remove --purge'
  alias update='sudo apt update && sudo apt upgrade && sudo apt autoremove'
fi

# Only run in interactive shell
[[ $- != *i* ]] && return

