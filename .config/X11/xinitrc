### ────────────────────────────
### 🧠 System Init

if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

unset GREP_OPTIONS


### ────────────────────────────
### 🖥️ Display / Monitor Setup

if command -v xrandr >/dev/null 2>&1 && [ -n "$DISPLAY" ]; then

  XR="$(xrandr)"

  ### Dual Monitor: DP-1 (LEFT) + eDP-1 (RIGHT)
  if echo "$XR" | grep -q '^DP-1 connected' && echo "$XR" | grep -q '^eDP-1 connected'; then

    xrandr \
      --output DP-1  --mode 3840x2160 --scale 0.8x0.8 --pos 0x0 --filter nearest \
      --output eDP-1 --primary --mode 1920x1080 --scale 1x1 --right-of DP-1

  ### Fallback: Laptop Only
  elif echo "$XR" | grep -q '^eDP-1 connected'; then

    xrandr --output eDP-1 --auto --primary

  fi

fi


### ────────────────────────────
### 🚀 Window Manager

exec xmonad
