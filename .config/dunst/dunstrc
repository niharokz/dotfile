# naos · dunstrc · nss theme
# Notification daemon, started once per session by xmonad. Test: notify-send -u critical "title" "body"

[global]
    monitor = 0
    follow = mouse                       # show on the screen you are working on
    width = (280, 380)
    height = 160                         # max height
    origin = top-right
    offset = 14x46                       # below the 32 px xmobar
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 1
    corner_radius = 10
    separator_height = 0
    sort = yes                           # most urgent first
    idle_threshold = 120                 # keep notices up while you are away
    font = JetBrains Mono 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span foreground='#8B979A'>%b</span>"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    show_age_threshold = 60
    icon_position = off                  # nss uses text, not icons
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2
    highlight = "#66BDB3"
    dmenu = /usr/bin/dmenu -p dunst
    browser = /usr/bin/xdg-open
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0F161B"
    foreground = "#8B979A"
    frame_color = "#1F2C33"
    timeout = 5

[urgency_normal]
    background = "#0F161B"
    foreground = "#E6ECEC"
    frame_color = "#3A807A"
    timeout = 8

[urgency_critical]
    background = "#1A1112"
    foreground = "#FF6B6B"
    frame_color = "#FF6B6B"
    timeout = 0                          # stays until clicked

# battery notices from naos-battery: amber frame for normal, red stays as above
[battery_normal]
    appname = battery
    msg_urgency = normal                 # match (not set) the urgency
    frame_color = "#E0A63A"
    foreground = "#E0A63A"
